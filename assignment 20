<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Multi-page HTML project: Home, About, Registration and Contact.">
  <meta name="author" content="Shubhanshu Kushwaha">
  <title>Multi-Page Project – Home</title>

  <!-- Pure HTML "pages": each <section class="page"> acts as a page. -->
  <style>
    .page {
      display: none;
    }

    .page:target,
    body:not(:has(.page:target)) #home {
      display: block;
    }

    body {
      font-family: system-ui, sans-serif;
      max-width: 760px;
      margin: 0 auto;
      padding: 1rem;
    }
  </style>
</head>

<body>
  <header>
    <h1>Shubhanshu's Website</h1>
    <p><strong>Student ID:</strong> BCAI2026081</p>
    <p><strong>Course:</strong> BCA</p>
    <nav aria-label="Main">
      <a href="#home">Home</a> |
      <a href="#about">About</a> |
      <a href="#registration">Registration</a> |
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main>
    <section id="home" class="page">
      <h2>Home</h2>
      <p>Welcome! I am Shubhanshu Kushwaha, a BCA student learning front-end development.</p>
      <img src="https://picsum.photos/id/1018/600/260" width="600" height="260" style="max-width:100%;height:auto"
        alt="Mountain landscape at sunrise">
      <h3>What you can do here</h3>
      <ul>
        <li>Read <a href="#about">about me</a></li>
        <li><a href="#registration">Register</a> for the workshop</li>
        <li>Send a message via the <a href="#contact">contact page</a></li>
      </ul>
    </section>

    <section id="about" class="page">
      <h2>About</h2>
      <p>I am Shubhanshu Kushwaha, a BCA student learning front-end development.</p>
      <table border="1" cellpadding="6">
        <caption>Quick facts</caption>
        <tr>
          <th scope="row">Name</th>
          <td>Shubhanshu Kushwaha</td>
        </tr>
        <tr>
          <th scope="row">Student ID</th>
          <td>BCAI2026081</td>
        </tr>
        <tr>
          <th scope="row">Course</th>
          <td>BCA</td>
        </tr>
        <tr>
          <th scope="row">Interests</th>
          <td>Web development, cricket, music</td>
        </tr>
      </table>
    </section>

    <section id="registration" class="page">
      <h2>Workshop Registration</h2>
      <form action="#" method="post">
        <p><label>Name <input type="text" name="name" value="Shubhanshu Kushwaha" required></label></p>
        <p><label>Email <input type="email" name="email" required></label></p>
        <p><label>Mobile <input type="tel" name="phone" value="8887955490"></label></p>
        <p><label>Date of birth <input type="date" name="dob"></label></p>
        <p><label>Course
            <select name="course">
              <option selected>BCA</option>
              <option>BBA</option>
              <option>Other</option>
            </select></label></p>
        <p><label>Level
            <select name="level">
              <option>Beginner</option>
              <option>Intermediate</option>
            </select></label></p>
        <button type="submit">Register</button>
      </form>
    </section>

    <section id="contact" class="page">
      <h2>Contact</h2>
      <form action="#" method="post">
        <p><label>Your name <input type="text" name="n" value="Shubhanshu Kushwaha" required></label></p>
        <p><label>Your email <input type="email" name="email" required></label></p>
        <p><label>Message<br><textarea name="m" rows="5" cols="40" required></textarea></label></p>
        <button type="submit">Send</button>
      </form>
      <address>Mobile: <a href="tel:8887955490">8887955490</a></address>
    </section>
  </main>

  <footer>
    <hr>
    <p><small>&copy; 2026 Shubhanshu Kushwaha · <a href="#home">Back to Home</a></small></p>
  </footer>
</body>

</html>