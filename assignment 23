<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Resume of Shubhanshu Kushwaha with font pairing and a colour palette.">
  <meta name="author" content="Shubhanshu Kushwaha">
  <title>Shubhanshu Kushwaha – Resume (Palette &amp; Fonts)</title>

  <!-- Font pairing: Playfair Display + Source Sans 3 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Source+Sans+3:wght@400;600&display=swap"
    rel="stylesheet">

  <style>
    /* Palette (60-30-10 rule):
       60% cream  #faf6f0  – background
       30% navy   #1b2a41  – text & header
       10% amber  #e09f3e  – accents
    */
    body {
      margin: 0;
      font-family: 'Source Sans 3', Georgia, sans-serif;
      background: #faf6f0;
      color: #1b2a41;
      line-height: 1.65;
    }

    h1,
    h2,
    h3 {
      font-family: 'Playfair Display', Georgia, serif;
    }

    header {
      background: #1b2a41;
      color: #faf6f0;
      padding: 2.5rem 1.5rem;
      text-align: center;
    }

    header h1 {
      margin: 0;
      font-size: 2.6rem;
    }

    header p {
      color: #e09f3e;
      margin: .25rem 0 0;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    main {
      max-width: 720px;
      margin: 0 auto;
      padding: 1.5rem;
    }

    h2 {
      color: #1b2a41;
      border-bottom: 2px solid #e09f3e;
      display: inline-block;
      padding-bottom: .15rem;
    }

    h3 {
      margin-bottom: 0;
    }

    .meta {
      color: #5c6b80;
      margin-top: 0;
    }

    ul.skills {
      list-style: none;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: .5rem;
    }

    ul.skills li {
      background: #1b2a41;
      color: #faf6f0;
      padding: .25rem .8rem;
      border-radius: 999px;
      font-weight: 600;
    }

    a {
      color: #b8751a;
    }

    footer {
      text-align: center;
      padding: 1rem;
      color: #5c6b80;
    }
  </style>
</head>

<body>
  <header>
    <h1>Shubhanshu Kushwaha</h1>
    <p>BCA Student | Aspiring Web Developer</p>
    <p>Student ID: BCAI2026081</p>
    <p>Mobile: 8887955490</p>
  </header>

  <main>
    <section>
      <h2>Profile</h2>
      <p>Motivated BCA student who enjoys learning web development and creating accessible, responsive web pages.</p>
    </section>

    <section>
      <h2>Education</h2>
      <h3>Bachelor of Computer Applications (BCA)</h3>
      <p class="meta">College/University: To be updated</p>
    </section>

    <section>
      <h2>Projects</h2>
      <h3>Personal Portfolio</h3>
      <p class="meta">HTML5 · CSS3</p>
      <p>A multi-page, semantic, responsive website.</p>
    </section>

    <section>
      <h2>Skills</h2>
      <ul class="skills">
        <li>HTML5</li>
        <li>CSS3</li>
        <li>Git</li>
        <li>GitHub</li>
        <li>VS Code</li>
      </ul>
    </section>

    <p>Contact: <a href="tel:8887955490">8887955490</a></p>
  </main>

  <footer>
    <small>Fonts: Playfair Display + Source Sans 3 · Palette: cream / navy / amber</small>
  </footer>
</body>

</html>